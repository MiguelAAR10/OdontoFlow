# Runtime mode. Production disables /docs, /redoc and /openapi.json.
APP_ENV=development

# PostgreSQL is the only source of truth. Replace these local-development
# values in the deployment secret store; never commit real credentials.
DATABASE_URL=postgresql+psycopg://odontoflow:odontoflow@127.0.0.1:5434/odontoflow
TEST_DATABASE_URL=postgresql+psycopg://odontoflow:odontoflow@127.0.0.1:5434/odontoflow_test

# Compat shim for pre-auth ERP callers. MUST be false when APP_ENV=production.
ERP_ANONYMOUS_COMPAT=true

# Emergency stop for every authenticated integration route.
INTEGRATION_API_ENABLED=true

# HTTP boundary controls.
MAX_JSON_BODY_BYTES=262144
RATE_LIMIT_READS_PER_MINUTE=600
RATE_LIMIT_MUTATIONS_PER_MINUTE=120
CORS_ALLOWED_ORIGINS=
REQUIRE_HTTPS=false

# Raw message bodies are redacted after this many days.
MESSAGE_CONTENT_RETENTION_DAYS=90

# Safe runner defaults. Production must terminate TLS here or explicitly list
# the trusted reverse-proxy IPs that terminate it upstream.
API_HOST=127.0.0.1
API_PORT=8000
TLS_CERTFILE=
TLS_KEYFILE=
TRUSTED_PROXY_IPS=

# --- Sales Agent (optional process; only needed with the `agent` extra) ---
# Agent memory MUST be its own database — never odontoflow/odontoflow_test/odontoflow_e2e.
SALES_AGENT_DATABASE_URL=postgresql+psycopg://odontoflow:odontoflow@127.0.0.1:5434/odontoflow_agent
SALES_AGENT_BACKEND_URL=http://127.0.0.1:8000
SALES_AGENT_V0_CREDENTIAL=
SALES_AGENT_MODEL_PROVIDER=openrouter
SALES_AGENT_MODEL=deepseek/deepseek-v4-flash-0731
SALES_AGENT_MODEL_BASE_URL=https://openrouter.ai/api/v1
# Required only for real-model execution. Never commit the value.
OPENROUTER_API_KEY=
# Native OpenAI remains supported when explicitly selected:
# SALES_AGENT_MODEL_PROVIDER=openai
# SALES_AGENT_MODEL=gpt-5.4-mini
# OPENAI_API_KEY=
SALES_AGENT_RECURSION_LIMIT=12
SALES_AGENT_REQUEST_TIMEOUT_SECONDS=10.0
# Deprecated fallbacks, read only if the SALES_AGENT_* name above is unset:
# AGENT_DATABASE_URL, BACKEND_BASE_URL, SALES_AGENT_CREDENTIAL

# --- Local sandbox outbound (development/testing only) ---
# The dispatcher refuses non-loopback receivers and missing credentials.
SANDBOX_BACKEND_URL=http://127.0.0.1:8000
SANDBOX_RECEIVER_URL=http://127.0.0.1:8000/internal/sandbox/receive
SANDBOX_CHANNEL_ACCOUNT_EXTERNAL_ID=sandbox-local
SANDBOX_INBOUND_TOKEN=
SANDBOX_DISPATCHER_TOKEN=
SANDBOX_REQUEST_TIMEOUT_SECONDS=10.0
