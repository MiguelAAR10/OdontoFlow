# Runtime mode. Production disables /docs, /redoc and /openapi.json.
APP_ENV=development

# PostgreSQL is the only source of truth. Replace these local-development
# values in the deployment secret store; never commit real credentials.
DATABASE_URL=postgresql+psycopg://odontoflow:odontoflow@127.0.0.1:5434/odontoflow
TEST_DATABASE_URL=postgresql+psycopg://odontoflow:odontoflow@127.0.0.1:5434/odontoflow_test

# Emergency stop for every authenticated integration route.
INTEGRATION_API_ENABLED=true

# HTTP boundary controls.
MAX_JSON_BODY_BYTES=262144
RATE_LIMIT_READS_PER_MINUTE=600
RATE_LIMIT_MUTATIONS_PER_MINUTE=120
CORS_ALLOWED_ORIGINS=
REQUIRE_HTTPS=false

# Raw message bodies are redacted after this many days.
MESSAGE_CONTENT_RETENTION_DAYS=90

# Safe runner defaults. Production must terminate TLS here or explicitly list
# the trusted reverse-proxy IPs that terminate it upstream.
API_HOST=127.0.0.1
API_PORT=8000
TLS_CERTFILE=
TLS_KEYFILE=
TRUSTED_PROXY_IPS=
